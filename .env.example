# Plantilla de claves de RainTube.
# Copia este archivo como ".env" y rellena cada valor con tu clave real.
# El .env real NO se sube al repo (esta en .gitignore).

# n8n (Settings > API > crear API key)
N8N_API_KEY=

# OpenRouter (auto-generacion de SEO con IA) - CRITICO
OPENROUTER_API_KEY=

# YouTube OAuth (Google Cloud Console)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Fuentes de material (opcionales para el canal de lluvia/agua)
PEXELS_API_KEY=
PIXABAY_API_KEY=
FREESOUND_API_KEY=
FREESOUND_CLIENT_ID=

# Ruta de FFmpeg (en Mac suele ser /opt/homebrew/bin o /usr/local/bin tras 'brew install ffmpeg')
FFMPEG_PATH=
